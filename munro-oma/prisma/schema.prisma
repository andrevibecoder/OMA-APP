generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MANAGER
  USER
}

enum MetricUnit {
  NUMBER
  CURRENCY
  PERCENT
  DAYS
}

enum MetricDirection {
  HIGHER_BETTER
  LOWER_BETTER
}

enum MetricSource {
  MANUAL
  API
}

enum PeriodKind {
  QUARTER
  HALF
  ANNUAL
}

model User {
  id             String        @id @default(cuid())
  name           String
  email          String        @unique
  passwordHash   String
  role           Role          @default(USER)
  active         Boolean       @default(true)
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id])
  businessUnitId String?
  manager        User?         @relation("TeamMembers", fields: [managerId], references: [id])
  managerId      String?
  team           User[]        @relation("TeamMembers")
  omas           OMA[]         @relation("OwnedOMAs")
  createdOmas    OMA[]         @relation("CreatedOMAs")
  loginEvents    LoginEvent[]
  createdAt      DateTime      @default(now())
}

model LoginEvent {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model BusinessUnit {
  id    String @id @default(cuid())
  name  String @unique
  order Int    @default(0)
  users User[]
}

model Period {
  id         String     @id @default(cuid())
  label      String     @unique // "Q3 2026", "H1 2026", "FY 2026"
  shortLabel String // "Q3", "H1", "FY" — for breadcrumbs
  kind       PeriodKind @default(QUARTER)
  year       Int
  startDate  DateTime
  isActive   Boolean    @default(false)
  // Independent of isActive: once locked, only Admin may create/edit OMAs
  // against this period. Locking doesn't change which period is "active" —
  // an admin can close off H2 2026 while it's still the default view, ahead
  // of activating H1 2027.
  locked     Boolean    @default(false)
  omas       OMA[]
}

model OMA {
  id          String    @id @default(cuid())
  owner       User      @relation("OwnedOMAs", fields: [ownerId], references: [id])
  ownerId     String
  // Who actually started this OMA — distinct from ownerId (whose OMA it is).
  // An owner may edit their own Outcome/Metric only on OMAs they created
  // themselves; one a manager set up for them stays manager/admin-only there.
  createdBy   User?     @relation("CreatedOMAs", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  period      Period    @relation(fields: [periodId], references: [id])
  periodId    String
  sequence    Int
  date        DateTime  @default(now()) // period start ("From")
  endDate     DateTime? // period end ("To")
  outcome     String
  metrics     Metric[]
  actions     Action[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([ownerId, periodId, sequence])
}

model Metric {
  id        String          @id @default(cuid())
  oma       OMA             @relation(fields: [omaId], references: [id], onDelete: Cascade)
  omaId     String
  measure   String
  unit      MetricUnit      @default(NUMBER)
  direction MetricDirection @default(HIGHER_BETTER)
  target    Float
  current   Float           @default(0)
  order     Int             @default(0)
  source    MetricSource    @default(MANUAL)
  // Placeholder for a future live sync — captured now, not yet fetched from.
  apiUrl    String?
  apiPath   String? // dot-path into the JSON response, e.g. "data.value"
  apiKey    String?
}

model Action {
  id          String    @id @default(cuid())
  oma         OMA       @relation(fields: [omaId], references: [id], onDelete: Cascade)
  omaId       String
  description String
  dueDate     DateTime?
  completed   Boolean   @default(false)
  completedAt DateTime?
  order       Int       @default(0)
}
